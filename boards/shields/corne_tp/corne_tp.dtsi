/*
 * Corne TP shield base — derived from the upstream Corne shield
 * (zmk/app/boards/shields/corne/corne.dtsi), with:
 *   - OLED node removed (no display on this build)
 *   - kscan-composite added so encoder push-switches can sit alongside the matrix
 *   - one rotary encoder per half (alps,ec11) declared but disabled — each
 *     side overlay enables only its own encoder
 *   - matrix-transform extended with two extra positions for the encoder clicks
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        /*
         * EXPERIMENT: chosen kscan is the matrix directly, not the composite.
         *   - This fork's zmk,kscan-composite.yaml binding does not accept the
         *     wakeup-source property, so we cannot make the composite itself
         *     wakeup-capable in DT.
         *   - kscan_composite_disable_callback cascades SUSPEND to its children
         *     and forcibly clears wakeup-enable on them — so even pointing the
         *     physical-layout at &kscan0 would lose wakeup once composite is
         *     suspended.
         *   - Bypassing the composite (and disabling its node below) cleanly
         *     proves whether the physical-layout + wakeup-enable mechanism
         *     restores System-OFF wake.
         * Side effect: encoder push-switches stop firing (no composite to
         * route kscan_encoder_clicks events into the keymap). Encoder rotation
         * still works (separate sensor path). Acceptable for this test.
         */
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        /*
         * physical-layout pointer is what makes zmk_physical_layouts_init
         * (app/src/physical_layouts.c:472-481) call pm_device_wakeup_enable()
         * on the layout's kscan at boot. With it set and kscan0 wakeup-capable
         * (wakeup-source declared on the kscan-gpio-matrix node below),
         * zmk_pm_suspend_devices (app/src/pm.c:46) skips kscan0 on deep-sleep
         * entry — GPIO interrupts stay armed, SENSE wakes the chip from
         * System OFF on the next key press.
         */
        zmk,physical-layout = &corne_tp_layout;
    };

    /*
     * Composite kscan kept declared so the device tree compiles cleanly
     * (corne_tp.dtsi is shared by both side overlays which reference these
     * labels), but disabled so it isn't instantiated as a Zephyr device.
     * No device → no PM action → no cascading suspend that would clobber the
     * wakeup-enable on kscan0.
     */
    kscan_composite: kscan_composite {
        compatible = "zmk,kscan-composite";
        status = "disabled";
        rows = <5>;
        columns = <12>;

        matrix {
            kscan = <&kscan0>;
        };

        encoder_clicks {
            kscan = <&kscan_encoder_clicks>;
            row-offset = <4>;
        };
    };

    /*
     * Minimal physical-layout. The `kscan` property is omitted, so it falls
     * back to the chosen zmk,kscan (= &kscan_composite). The `keys` array is
     * also omitted — we don't need ZMK Studio key-position metadata for the
     * deep-sleep wake path, only the layout-to-kscan link that triggers
     * pm_device_wakeup_enable() at init.
     */
    corne_tp_layout: corne_tp_layout {
        compatible = "zmk,physical-layout";
        display-name = "Corne TP";
        transform = <&default_transform>;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        /*
         * Rows 0-2: 6 per side (12 cols).
         * Row 3: 3 thumb keys per side.
         * Row 4: encoder click — col 0 is left, col 6 is right (after the
         *        per-side col-offset on the right overlay).
         */
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
                                        RC(4,0)  RC(4,6)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    /*
     * Encoder push-switch on D8 = P1.04.
     * Wired through gpio-direct so it produces a (row=0, col=0) event that
     * the composite shifts to row 4. The per-side overlay does not need to
     * touch this — both halves use the same pin and the matrix-transform's
     * col-offset takes care of separating left vs right clicks.
     */
    kscan_encoder_clicks: kscan_encoder_clicks {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&pro_micro 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>
            ;
    };

    /* Encoder A on D16 = P0.10, B on D10 = P0.09 — same pins on both halves
     * for handwiring symmetry. Each side overlay enables only its own.
     *
     * steps = <40>: the MEH01 (Kailh 5 mm mouse encoder) emits 2 quadrature
     * transitions per detent click, not 4 like a tactile EC11. Verified
     * empirically: with the previous steps=<80>, 10 physical detents
     * produced 5 wheel events (4 transitions per trigger × 2 transitions
     * per detent = 8 transitions per trigger = 2 detents per trigger).
     * Halving steps to 40 gives 1 detent = 1 trigger = 1 wheel event. */
    left_encoder: left_encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
        status = "disabled";
    };

    right_encoder: right_encoder {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <40>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };
};
